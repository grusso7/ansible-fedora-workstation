# .zshrc generato da Ansible per {{ desktop_user }}

# Abilita i colori per ls
alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Configurazione di base della history
HISTFILE={{ user_home }}/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt sharehistory
setopt incappendhistory

# Mappatura dei tasti inviata dai terminali compatibili con xterm.
# Senza queste associazioni le sequenze ANSI vengono mostrate come testo.
bindkey -e
bindkey '\e[1;5D' backward-word
bindkey '\e[1;5C' forward-word
bindkey '\e[5D' backward-word
bindkey '\e[5C' forward-word
bindkey '\e[3~' delete-char

# Ctrl + Backspace
bindkey '^H' backward-kill-word
bindkey '\e[3;5~' delete-word

# Home / End
bindkey '\e[H' beginning-of-line
bindkey '\e[F' end-of-line
bindkey '\e[1~' beginning-of-line
bindkey '\e[4~' end-of-line

# Insert / Delete
bindkey '\e[2~' overwrite-mode
bindkey '\e[3~' delete-char

# Page Up / Page Down
bindkey '\e[5~' up-line-or-history
bindkey '\e[6~' down-line-or-history

# Caricamento dei plugin installati via pacchetti Debian
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Prompt minimale
autoload -Uz compinit && compinit
PROMPT='%F{green}%n@%m%f:%F{blue}%~%f$ '

# Override locali (Bun, Codex, alias personali, ecc.) — non gestiti da Ansible
[[ -f {{ user_home }}/.zshrc.local ]] && source {{ user_home }}/.zshrc.local
